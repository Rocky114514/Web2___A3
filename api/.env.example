# Copy this file to ".env" and update the values for your local / cPanel MySQL.
# The real ".env" file is git-ignored so your password is never published.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=charityevents_db

# Port the API listens on (the SCU cPanel deployment may require a specific one).
PORT=3000
